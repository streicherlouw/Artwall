{
  "receiverName": "Art Wall",
  "uxplayPath": "/usr/local/bin/uxplay",
  "fullscreen": false,
  "pin": false,
  "persistTrustedClients": false,
  "port": 7000,
  "resolution": "1920x1080@30",
  "fps": 30,
  "lowLatency": false,
  "noFreeze": true,
  "inhibitScreensaver": false,
  "videoSink": "waylandsink fullscreen=true sync=true async=false enable-last-sample=false processing-deadline=0",
  "audioSink": "pulsesink sync=true async=false buffer-time=20000 latency-time=10000 processing-deadline=0",
  "waylandDisplay": "wayland-0",
  "xdgRuntimeDir": "/run/user/1000",
  "dbusSessionBusAddress": "unix:path=/run/user/1000/bus",
  "useBt709": true,
  "extraArgs": [
    "-FPSdata",
    "-vd",
    "avdec_h264",
    "-vc",
    "videoconvert",
    "-db",
    "-50:0",
    "-taper",
    "-srgb",
    "no",
    "-nc",
    "no"
  ],
  "restartOnExit": true,
  "restartDelay": 5000,
  "externalStatusFile": "/run/user/1000/airplay-receiver-status.json",
  "manageSystemVolume": true,
  "systemVolumeLimitPercent": 100,
  "systemVolumeTarget": "@DEFAULT_AUDIO_SINK@",
  "wpctlPath": "/usr/bin/wpctl",
  "manageDisplayPower": true,
  "displayOutput": "HDMI-A-1",
  "wlrRandrPath": "/usr/bin/wlr-randr",
  "manageBlackFrameGuard": true,
  "blackFrameCommand": "/usr/bin/gst-launch-1.0",
  "blackFrameReadyDelayMs": 400,
  "blackFrameTerminationTimeoutMs": 1500,
  "blackFrameRate": 10,
  "videoTeardownTimeoutMs": 2000,
  "receiverRecycleKillTimeoutMs": 2000,
  "receiverOutputSampleLines": 0,
  "performanceReportSamples": 3,
  "debugReceiver": true,
  "web": {
    "host": "0.0.0.0",
    "port": 8768
  }
}
