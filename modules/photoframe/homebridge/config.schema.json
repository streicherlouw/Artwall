{
  "pluginAlias": "ArtwallPhotoFrame",
  "pluginType": "platform",
  "singular": true,
  "headerDisplay": "Creates HomeKit switches for root albums and artist/movement collections above the prominence cutoff configured in PhotoFrame. Turning an album on starts its slideshow; only the playing album is on.",
  "schema": {
    "type": "object",
    "properties": {
      "name": {
        "title": "Name",
        "type": "string",
        "default": "Artwall PhotoFrame"
      },
      "baseUrl": {
        "title": "PhotoFrame URL",
        "type": "string",
        "default": "http://127.0.0.1:8767"
      },
      "pollInterval": {
        "title": "Status polling interval (seconds)",
        "type": "integer",
        "minimum": 2,
        "default": 5
      }
    }
  },
  "customUi": true
}
