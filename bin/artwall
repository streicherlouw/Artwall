#!/usr/bin/env node
'use strict';
const path=require('node:path'),{spawnSync}=require('node:child_process');
const{configPath,readJSON}=require('../common/config');
const args=process.argv.slice(2),[moduleId,action,...rest]=args;
const help=`Artwall commands:
  artwall status
  artwall photoframe start|stop|next|previous|pause|resume|status
  artwall photoframe import FOLDER [--album NAME]
  artwall splitflap show "YOUR MESSAGE" [--sound]
  artwall splitflap start|stop|status
  artwall airplay status
  artwall portal status
Environment: ARTWALL_CONFIG_DIR overrides ~/.config/artwall.
All display commands use the same local HTTP API as remote callers.`;
async function request(id,route,body){const c=readJSON(configPath(id)),port=id==='airplay'||id==='splitflap'?c.web.port:c.port;const response=await fetch(`http://127.0.0.1:${port}${route}`,{method:body?'POST':'GET',headers:body?{'Content-Type':'application/json'}:{},body:body?JSON.stringify(body):undefined,signal:AbortSignal.timeout(30000)});const data=await response.json();if(!response.ok||data.ok===false)throw Error(data.error||`HTTP ${response.status}`);return data}
(async()=>{
 if(!moduleId||moduleId==='--help'){console.log(help);return}
 if(moduleId==='status'){const ids=['photoframe','splitflap','airplay','portal'];for(const id of ids){try{console.log(id,JSON.stringify(await request(id,'/api/status')))}catch(e){console.log(id,e.code==='ENOENT'?'not installed':e.message)}}return}
 if(moduleId==='photoframe'&&action==='import'){if(!rest[0])throw Error('Provide an image folder');const result=spawnSync('/usr/bin/python3',[path.join(__dirname,'../modules/photoframe/import.py'),'--config',configPath(moduleId),...rest],{stdio:'inherit'});process.exitCode=result.status??1;return}
 let route='/api/status',body;
 if(moduleId==='photoframe'&&['start','stop','next','previous','pause','resume'].includes(action)){route='/api/slideshow/command';body={action}}
 else if(moduleId==='splitflap'&&action==='show'){const words=rest.filter(x=>x!=='--sound');if(!words.length)throw Error('Provide a message');route='/api/message';body={text:words.join(' '),sound:rest.includes('--sound')}}
 else if(moduleId==='splitflap'&&action==='start'){route='/api/message';body={type:'activate',mode:'auto'}}
 else if(moduleId==='splitflap'&&action==='stop'){route='/api/end';body={}}
 else if(!['photoframe','splitflap','airplay','portal'].includes(moduleId)||action!=='status')throw Error(help);
 console.log(JSON.stringify(await request(moduleId,route,body),null,2));
})().catch(e=>{console.error(e.message);process.exitCode=1});
